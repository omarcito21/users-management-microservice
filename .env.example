# Copie este archivo como .env y reemplace todos los valores de ejemplo.
# Nunca incluya credenciales reales en Git.
DB_NAME=crud_usuarios
DB_PASSWORD=CAMBIAR_por_una_clave_local_segura
MYSQL_ROOT_PASSWORD=CAMBIAR_por_otra_clave_local_segura
DB_SSL_MODE=DISABLED

# Brevo: obtener la API key REST (prefijo xkeysib-) y verificar el remitente en Brevo.
NOTIFICATION_PROVIDER=brevo
BREVO_BASE_URL=https://api.brevo.com
BREVO_API_KEY=xkeysib-REEMPLAZAR_con_tu_clave_real
BREVO_FROM_ADDRESS=remitente-verificado@example.com
BREVO_FROM_NAME=Gestion de Usuarios

# Secreto Base64 de al menos 32 bytes para desarrollo local.
JWT_SECRET=REEMPLAZAR_con_base64_de_32_bytes_aleatorios
JWT_EXPIRATION_SECONDS=900

# Alternativa: usar el proveedor SMTP en lugar de Brevo.
# NOTIFICATION_PROVIDER=smtp
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USERNAME=REEMPLAZAR_con_usuario_smtp_de_Brevo
# SMTP_PASSWORD=REEMPLAZAR_con_clave_smtp_de_Brevo
# SMTP_FROM_ADDRESS=remitente-verificado@example.com
# SMTP_FROM_NAME=Gestion de Usuarios
